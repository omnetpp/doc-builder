# The default doxygen configuration of the action, used unless the `doxyfile` input names another one.
# Derived from the one of the OMNeT++ API documentation. The action appends INPUT, PROJECT_NAME and the
# output settings it relies on; $(DOC_BUILDER_ACTION_DIR) is the directory of the action.

ALWAYS_DETAILED_SEC    = YES
ABBREVIATE_BRIEF       =
FULL_PATH_NAMES        = NO
PYTHON_DOCSTRING       = NO
# rst/endrst embed reStructuredText in comments, rendered by doxysphinx in Sphinx sites
ALIASES                = opp=OMNeT++ \
                         "rst=\verbatim embed:rst:leading-asterisk" \
                         endrst=\endverbatim
TOC_INCLUDE_HEADINGS   = 3
BUILTIN_STL_SUPPORT    = YES
HIDE_UNDOC_MEMBERS     = YES
HIDE_UNDOC_CLASSES     = YES
CASE_SENSE_NAMES       = YES
HIDE_SCOPE_NAMES       = YES
SHOW_INCLUDE_FILES     = NO
SORT_MEMBER_DOCS       = NO
SHOW_USED_FILES        = NO
LAYOUT_FILE            = $(DOC_BUILDER_ACTION_DIR)/doxygen/DoxygenLayout.xml
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
FILE_PATTERNS          = *.h
RECURSIVE              = YES
# message classes generated by opp_msgc
EXCLUDE_PATTERNS       = *_m.h
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
ALPHABETICAL_INDEX     = NO
HTML_EXTRA_STYLESHEET  = $(DOC_BUILDER_ACTION_DIR)/doxygen/doxygen-awesome.css
GENERATE_TREEVIEW      = NO
SEARCHENGINE           = NO
GENERATE_LATEX         = NO
HAVE_DOT               = YES
COLLABORATION_GRAPH    = NO
GROUP_GRAPHS           = NO
INCLUDE_GRAPH          = NO
INCLUDED_BY_GRAPH      = NO
GRAPHICAL_HIERARCHY    = NO
DIRECTORY_GRAPH        = NO
DOT_IMAGE_FORMAT       = svg
MAX_DOT_GRAPH_DEPTH    = 2
