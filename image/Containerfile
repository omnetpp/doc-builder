# OMNeT++ documentation builder image.
#
# Contains the complete toolchain to build the unified Sphinx documentation site
# (manual + guides + doxygen APIs + Python API) as HTML and as PDF: doxygen,
# graphviz, a pinned pandoc for the manual LaTeX->RST conversion, the Python Sphinx
# stack from the pinned uv.lock, and TeX Live, ImageMagick and rsvg-convert for the
# PDF documents. HTML math is rendered client-side by KaTeX.
# It also carries the OMNeT++ command-line tools (opp_docgen, opp_lint, opp_lsp,
# opp_ide_mcp) so the image can generate NED documentation, e.g. as the base of a
# model library's (INET's) documentation build, and five Sphinx extensions:
# omnetpp_immaterial, the shared look of the OMNeT++ sites, omnetpp_doxylink,
# roles that link C++ symbols to doxygen API pages, omnetpp_lexers, the
# highlighting of NED, MSG, ini and fingerprint code blocks, omnetpp_media,
# video and audio directives, and omnetpp_neddoc, roles that link NED and MSG
# types to the NED reference of opp_docgen.
#
# The Python packages are installed with uv into a venv that is on PATH, so a
# build runs WITHOUT uv inside the container.
#
# Build context must be the repository root (image/ and extensions/), and
# image/opp-tools.tgz must hold the opp-tools npm tarball. build.sh stages that
# file, so use it rather than invoking podman directly:
#     image/build.sh
#
# Size notes (kept lean on purpose):
#   - doxygen is the official static binary, NOT the apt package, because the
#     latter hard-depends on libclang/LLVM (~216 MB) that our doxyfiles never use.
#   - TeX Live and ImageMagick add about 0.5 GB. They are in the one image anyway:
#     a separate PDF image cost more in build time and upkeep than HTML-only
#     deploys saved by not pulling them.
#
# The platform is pinned: every tool below is fetched as an x86_64/amd64 binary,
# so building on an arm64 host without this would produce a broken image.
FROM --platform=linux/amd64 docker.io/library/ubuntu:26.04

# org.opencontainers.image.source is what makes GHCR link the published package to
# the repository, which in turn lets a workflow's GITHUB_TOKEN pull it. It is NOT
# set here on purpose: it must name the repository that actually publishes the
# image, so build.sh and doc-builder-image.yml pass it with --label at build time.
LABEL org.opencontainers.image.description="Toolchain for building the documentation sites of OMNeT++ and of its simulation models, including the PDF documents" \
      org.opencontainers.image.licenses="MIT"

ENV DEBIAN_FRONTEND=noninteractive

# System toolchain. graphviz renders the manual's .dot figures to SVG. TeX Live is
# the Ubuntu packaging (pinned by the release, docs left out by
# --no-install-recommends): latex-extra is needed by both Sphinx latexpdf and the
# Simulation Manual's preamble, fonts-recommended provides bookman & co., tex-gyre
# Sphinx's default fonts. ImageMagick is what sphinx.ext.imgconverter calls (as
# `convert`) to turn GIF/SVG images into something pdflatex can embed; its SVG coder
# is in the -extra package, which --no-install-recommends would skip (the name
# carries the ABI version, so it changes with the Ubuntu base). rsvg-convert renders
# the manual's SVG figures to PDF. perl and xmllint are for the LaTeX->HTML and
# LaTeX->Eclipse-help builds of the manual that go into the OMNeT++ release archives.
# All of it is in this first layer, which changes least, so that the large TeX
# download stays cached.
RUN apt-get update && apt-get install -y --no-install-recommends \
        graphviz \
        nodejs \
        python3 \
        make \
        git \
        curl \
        ca-certificates \
        texlive-latex-recommended \
        texlive-latex-extra \
        texlive-fonts-recommended \
        tex-gyre \
        latexmk \
        librsvg2-bin \
        imagemagick \
        libmagickcore-7.q16-10-extra \
        perl \
        libxml2-utils \
    && rm -rf /var/lib/apt/lists/* /var/log/* /var/cache/* /usr/share/doc/* /usr/share/man/*

# Doxygen: official binary release (no libclang dependency, unlike the apt package).
# NOT the absolute latest: doxygen >=1.15 emits modern relative-color CSS
# (hsl(from ...)) that doxysphinx's (deprecated, frozen) LibSass scoper cannot
# parse. 1.14.0 is the newest release that works with the current doxysphinx.
ARG DOXYGEN_VERSION=1.14.0
RUN set -eu; \
    tag="Release_$(echo "$DOXYGEN_VERSION" | tr . _)"; \
    curl -fsSL -o /tmp/doxygen.tgz \
        "https://github.com/doxygen/doxygen/releases/download/${tag}/doxygen-${DOXYGEN_VERSION}.linux.bin.tar.gz"; \
    tar -xzf /tmp/doxygen.tgz -C /tmp; \
    install -m0755 "/tmp/doxygen-${DOXYGEN_VERSION}/bin/doxygen" /usr/local/bin/doxygen; \
    rm -rf /tmp/doxygen.tgz "/tmp/doxygen-${DOXYGEN_VERSION}"; \
    doxygen --version   # fail the build early if the binary can't run

# Pandoc: drives the manual LaTeX->RST conversion (omnetpp-dev doc/src/manual/tools/tex2rst).
# Pinned for reproducibility (the converter is version-sensitive).
ARG PANDOC_VERSION=3.10
RUN curl -fsSL -o /tmp/pandoc.deb \
        "https://github.com/jgm/pandoc/releases/download/${PANDOC_VERSION}/pandoc-${PANDOC_VERSION}-1-amd64.deb" \
    && dpkg -i /tmp/pandoc.deb \
    && rm -f /tmp/pandoc.deb

# Python Sphinx toolchain, installed with uv from the pinned uv.lock into a venv
# that is on PATH (so the build needs neither uv nor pip at run time inside the
# container). uv is only needed at build time, so it is fetched and removed within
# this single layer; nothing extra persists in the image. Caches/bytecode stripped.
# Build the venv against a uv-managed CPython 3.12 rather than the base image's
# system Python: doxysphinx caps lxml at <=5.2.1, which has no wheel for newer
# Python, and we don't want a C toolchain in the image to compile it. The system
# python3 is still used for the stdlib-only helper scripts (tex2rst etc.).
ENV UV_PROJECT_ENVIRONMENT=/opt/docvenv \
    UV_PYTHON_INSTALL_DIR=/opt/uv-python \
    UV_PYTHON=3.12 \
    UV_PYTHON_DOWNLOADS=automatic
COPY image/pyproject.toml image/uv.lock /opt/docproj/
ARG UV_VERSION=0.13.1
RUN curl -fsSL -o /tmp/uv.tar.gz \
        "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-x86_64-unknown-linux-gnu.tar.gz" \
    && tar -xzf /tmp/uv.tar.gz -C /tmp \
    && (cd /opt/docproj && /tmp/uv-x86_64-unknown-linux-gnu/uv sync --frozen --no-dev --no-cache) \
    && find /opt/docvenv -type d -name '__pycache__' -prune -exec rm -rf {} + \
    && find /opt/docvenv -type f -name '*.pyc' -delete \
    && rm -rf /tmp/uv.tar.gz /tmp/uv-x86_64-unknown-linux-gnu /opt/docproj ~/.cache
ENV PATH="/opt/docvenv/bin:$PATH" VIRTUAL_ENV=/opt/docvenv

# sphinx_immaterial downloads its web fonts (the Google Fonts catalogue, and Roboto
# and Roboto Mono, whose TTF also goes to graphviz) when a build starts, unless
# they are in its cache. Filling the cache here keeps documentation builds off the
# network; the containers are thrown away after each build, so they would
# otherwise download the fonts every time. The theme writes to the cache only on a
# miss, so it can stay owned by root, but it creates the files readable by their
# owner only, while builds also run as other users. A project that sets other
# fonts in html_theme_options still downloads them (into a writable cache).
ENV SPHINX_IMMATERIAL_EXTERNAL_RESOURCE_CACHE_DIR=/opt/sphinx-immaterial-cache
RUN set -eu; \
    mkdir -p /tmp/fonts; \
    printf "html_theme = 'sphinx_immaterial'\nextensions = ['sphinx_immaterial']\n" > /tmp/fonts/conf.py; \
    printf 'Fonts\n=====\n' > /tmp/fonts/index.rst; \
    sphinx-build -b html -q /tmp/fonts /tmp/fonts/_build; \
    test -n "$(ls -A "$SPHINX_IMMATERIAL_EXTERNAL_RESOURCE_CACHE_DIR/google_fonts")"; \
    chmod -R a+rX "$SPHINX_IMMATERIAL_EXTERNAL_RESOURCE_CACHE_DIR"; \
    find /opt/docvenv -type d -name '__pycache__' -prune -exec rm -rf {} +; \
    rm -rf /tmp/fonts

# git refuses to operate on repos owned by another uid (bind-mounted host repo).
RUN git config --system --add safe.directory '*'

# PDF smoke check, failing the image build if the PDF toolchain is incomplete. It needs no file of the
# OMNeT++ extensions below, so changing them does not run it again:
#   - the Simulation Manual's preamble compiles with a one-line body (a copy of the
#     preamble of omnetpp-dev doc/src/manual/usman.tex, up to \begin{document}; renew
#     it when the manual needs new LaTeX packages);
#   - a tiny Sphinx project (image/smoke/pdf) builds to PDF with -W, both
#     with the OMNeT++ guides' fonts and with Sphinx's defaults (as INET uses), and
#     with a GIF and an SVG image, so a missing ImageMagick or coder is an error
#     rather than a silently dropped figure;
#   - rsvg-convert renders an SVG to PDF;
#   - the other tools of the manual's build (bibtex, makeindex, perl, xmllint) are there.
RUN --mount=type=bind,source=image/smoke/manual-preamble.tex,target=/tmp/manual-preamble.tex \
    --mount=type=bind,source=image/smoke/pdf,target=/tmp/pdf-smoke \
    set -eu; \
    mkdir -p /tmp/smoke/manual; \
    cp /tmp/manual-preamble.tex /tmp/smoke/manual/preamble.tex; \
    printf '\\begin{document}\nSmoke.\n\\end{document}\n' >> /tmp/smoke/manual/preamble.tex; \
    (cd /tmp/smoke/manual && pdflatex -halt-on-error -interaction=nonstopmode preamble.tex > /dev/null \
        || { tail -40 preamble.log; exit 1; }); \
    test -s /tmp/smoke/manual/preamble.pdf; \
    for fonts in omnetpp default; do \
        cp -r /tmp/pdf-smoke "/tmp/smoke/$fonts"; \
        convert -size 16x16 xc:steelblue "/tmp/smoke/$fonts/smoke.gif"; \
        SMOKE_FONTS=$fonts LATEXMKOPTS=-silent \
            sphinx-build -M latexpdf "/tmp/smoke/$fonts" "/tmp/smoke/$fonts/_build" -W -q; \
        test -s "/tmp/smoke/$fonts/_build/latex/smoke.pdf"; \
    done; \
    rsvg-convert -f pdf -o /tmp/smoke/smoke.pdf /tmp/pdf-smoke/smoke.svg; \
    test -s /tmp/smoke/smoke.pdf; \
    for tool in bibtex makeindex perl xmllint; do \
        command -v "$tool" > /dev/null || { echo "$tool is missing" >&2; exit 1; }; \
    done; \
    rm -rf /tmp/smoke

# Everything above is the toolchain, which only a new tool version or uv.lock changes; the
# layers below are the files of this repository and of opp-tools, ordered by how often they
# change, the theme (omnetpp_immaterial) last but for omnetpp_neddoc, whose check uses it.
# The extensions are plain modules, copied into the venv rather than installed from uv.lock,
# so that they can change without rebuilding the Sphinx stack; a site enables one by listing
# it in its extensions.

# omnetpp_doxylink: the Sphinx extension behind the :cppref: role of the OMNeT++ site, a fork of
# sphinxcontrib-doxylink that links C++ symbols to doxygen HTML pages via the doxygen tag file
# (extensions/omnetpp_doxylink). Its dependencies (requests, python-dateutil, pyparsing) are in uv.lock. A site
# enables it with extensions = [..., 'omnetpp_doxylink']. The smoke check fails the build if a site that links a class
# and a member through a tiny tag file does not build or does not get the links.
RUN --mount=type=bind,source=extensions/omnetpp_doxylink,target=/tmp/omnetpp_doxylink \
    set -eu; \
    site="$(python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')"; \
    cp -r /tmp/omnetpp_doxylink "$site/"; \
    find "$site/omnetpp_doxylink" -type d -name '__pycache__' -prune -exec rm -rf {} +; \
    chmod -R a+rX "$site/omnetpp_doxylink"; \
    mkdir -p /tmp/smoke; \
    printf "extensions = ['omnetpp_doxylink']\ndoxylink = {'cppref': ('tagfile.xml', 'api/')}\n" > /tmp/smoke/conf.py; \
    printf '<tagfile>\n<compound kind="class"><name>omnetpp::cSmoke</name><filename>classomnetpp_1_1cSmoke.html</filename>\n<member kind="function"><type>void</type><name>run</name><anchorfile>classomnetpp_1_1cSmoke.html</anchorfile><anchor>a1</anchor><arglist>()</arglist></member>\n</compound>\n</tagfile>\n' > /tmp/smoke/tagfile.xml; \
    printf 'Smoke\n=====\n\n:cppref:`omnetpp::cSmoke` and :cppref:`omnetpp::cSmoke::run()`\n' > /tmp/smoke/index.rst; \
    (cd /tmp/smoke && sphinx-build -b html -q -W . _build); \
    grep -q 'href="./api/classomnetpp_1_1cSmoke.html"' /tmp/smoke/_build/index.html; \
    grep -q 'href="./api/classomnetpp_1_1cSmoke.html#a1"' /tmp/smoke/_build/index.html; \
    find /opt/docvenv -type d -name '__pycache__' -prune -exec rm -rf {} +; \
    rm -rf /tmp/smoke

# omnetpp_lexers: the Pygments lexers of the OMNeT++ file formats as Sphinx code-block languages (ned, msg, ini, fp),
# which the NED reference generated by opp_docgen --format=rst needs for its ned and msg code blocks
# (extensions/omnetpp_lexers). A site enables it with extensions = [..., 'omnetpp_lexers']. The smoke check fails the
# build if a page with ned and msg code blocks does not build without warnings (an unknown language is one) or comes
# out without highlighting.
RUN --mount=type=bind,source=extensions/omnetpp_lexers,target=/tmp/omnetpp_lexers \
    set -eu; \
    site="$(python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')"; \
    cp -r /tmp/omnetpp_lexers "$site/"; \
    find "$site/omnetpp_lexers" -type d -name '__pycache__' -prune -exec rm -rf {} +; \
    chmod -R a+rX "$site/omnetpp_lexers"; \
    mkdir -p /tmp/smoke; \
    printf "extensions = ['omnetpp_lexers']\n" > /tmp/smoke/conf.py; \
    printf 'Smoke\n=====\n\n.. code-block:: ned\n\n   simple Smoke\n   {\n       parameters:\n           int count = 1;\n   }\n\n.. code-block:: msg\n\n   message SmokeMsg\n   {\n       int count;\n   }\n' > /tmp/smoke/index.rst; \
    sphinx-build -b html -q -W /tmp/smoke /tmp/smoke/_build; \
    grep -q '<span class="k">simple</span>' /tmp/smoke/_build/index.html; \
    grep -q '<span class="k">message</span>' /tmp/smoke/_build/index.html; \
    find /opt/docvenv -type d -name '__pycache__' -prune -exec rm -rf {} +; \
    rm -rf /tmp/smoke

# omnetpp_media: the video, video_noloop, audio, youtube and vimeo directives (extensions/omnetpp_media). A site
# enables it with extensions = [..., 'omnetpp_media']. The smoke check fails the build if a page with a YouTube video
# and a local video does not build, or does not get the embedded player or the published video file.
RUN --mount=type=bind,source=extensions/omnetpp_media,target=/tmp/omnetpp_media \
    set -eu; \
    site="$(python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')"; \
    cp -r /tmp/omnetpp_media "$site/"; \
    find "$site/omnetpp_media" -type d -name '__pycache__' -prune -exec rm -rf {} +; \
    chmod -R a+rX "$site/omnetpp_media"; \
    mkdir -p /tmp/smoke; \
    printf "extensions = ['omnetpp_media']\n" > /tmp/smoke/conf.py; \
    printf 'x' > /tmp/smoke/smoke.mp4; \
    printf 'Smoke\n=====\n\n.. youtube:: smokeid\n\n.. video:: smoke.mp4\n' > /tmp/smoke/index.rst; \
    sphinx-build -b html -q -W /tmp/smoke /tmp/smoke/_build; \
    grep -q 'src="https://www.youtube.com/embed/smokeid"' /tmp/smoke/_build/index.html; \
    grep -q 'src="_downloads/[0-9a-f]*/smoke.mp4"' /tmp/smoke/_build/index.html; \
    test -s /tmp/smoke/_build/_downloads/*/smoke.mp4; \
    find /opt/docvenv -type d -name '__pycache__' -prune -exec rm -rf {} +; \
    rm -rf /tmp/smoke

# OMNeT++ command-line tools from the @omnetpp/opp-tools npm package (built in the
# omnetpp-vscode repo). Its bundles are self-contained, so no npm is needed: the
# tarball is bind-mounted (leaving no layer behind), unpacked, and its bins linked
# onto PATH. The smoke check fails the build if opp_docgen cannot generate output.
RUN --mount=type=bind,source=image/opp-tools.tgz,target=/tmp/opp-tools.tgz \
    set -eu; \
    mkdir -p /opt/opp-tools; \
    tar -xzf /tmp/opp-tools.tgz -C /opt/opp-tools --strip-components=1 --no-same-owner; \
    for tool in opp_docgen opp_lint opp_lsp opp_ide_mcp; do \
        chmod 0755 "/opt/opp-tools/dist/$tool.js"; \
        ln -s "/opt/opp-tools/dist/$tool.js" "/usr/local/bin/$tool"; \
    done; \
    opp_docgen --version; \
    opp_lint --version; \
    mkdir -p /tmp/smoke/src; \
    printf '//\n// Smoke-test module.\n//\nsimple Smoke\n{\n}\n' > /tmp/smoke/src/Smoke.ned; \
    opp_docgen --format=rst -o /tmp/smoke/out /tmp/smoke/src; \
    grep -rq 'Smoke-test module' /tmp/smoke/out; \
    opp_lint /tmp/smoke/src; \
    rm -rf /tmp/smoke

# omnetpp_immaterial: the Sphinx extension that gives the OMNeT++ sites the density of the former OMNeT++
# documentation on top of sphinx_immaterial (extensions/omnetpp_immaterial). A site enables it with extensions = [...,
# 'omnetpp_immaterial']. The smoke check fails the build if a site with the extension does not build, does not get its
# stylesheet, or does not get the fixed site search, a :no-copy: page, the table of contents of a page outside every
# toctree, or the navigation trees loaded as JSON: of a toctree over the threshold, whose pages are left out of the
# navigation of the other pages, and of a doxygen API by namespace, or the light background of the transparent PNG
# images, and of the icons among them.
RUN --mount=type=bind,source=extensions/omnetpp_immaterial,target=/tmp/omnetpp_immaterial \
    set -eu; \
    site="$(python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')"; \
    cp -r /tmp/omnetpp_immaterial "$site/"; \
    find "$site/omnetpp_immaterial" -type d -name '__pycache__' -prune -exec rm -rf {} +; \
    chmod -R a+rX "$site/omnetpp_immaterial"; \
    mkdir -p /tmp/smoke; \
    printf "html_theme = 'sphinx_immaterial'\nextensions = ['sphinx_immaterial', 'omnetpp_immaterial']\nomnetpp_nav_json = ['api/index']\n" > /tmp/smoke/conf.py; \
    printf 'Smoke\n=====\n\n.. toctree::\n\n   ref/index\n   api/index\n' > /tmp/smoke/index.rst; \
    mkdir -p /tmp/smoke/ref /tmp/smoke/api; \
    printf 'Reference\n=========\n\n.. toctree::\n\n' > /tmp/smoke/ref/index.rst; \
    for i in $(seq 101); do \
        printf '   p%s\n' "$i" >> /tmp/smoke/ref/index.rst; \
        printf 'Page %s\n==========\n\nSection\n-------\n' "$i" > "/tmp/smoke/ref/p$i.rst"; \
    done; \
    printf '<tagfile>\n<compound kind="namespace"><name>ns</name><filename>namespacens.html</filename></compound>\n<compound kind="class"><name>ns::Foo</name><filename>classns_1_1Foo.html</filename></compound>\n</tagfile>\n' > /tmp/smoke/api/tagfile.xml; \
    printf 'API\n===\n\n.. toctree::\n\n   namespacens\n   classns_1_1Foo\n' > /tmp/smoke/api/index.rst; \
    printf 'ns\n==\n' > /tmp/smoke/api/namespacens.rst; \
    printf 'Foo\n===\n' > /tmp/smoke/api/classns_1_1Foo.rst; \
    printf ':orphan:\n:no-copy:\n\nNo copy\n=======\n\n.. code-block:: text\n\n   x\n' > /tmp/smoke/nocopy.rst; \
    printf ':orphan:\n\nOrphan\n======\n\nSection\n-------\n' > /tmp/smoke/orphan.rst; \
    python3 -c "import struct, zlib; chunk = lambda kind, body: struct.pack('>I', len(body)) + kind + body + struct.pack('>I', zlib.crc32(kind + body)); png = lambda path, width, color, pixel: open(path, 'wb').write(b'\x89PNG\r\n\x1a\n' + chunk(b'IHDR', struct.pack('>IIBBBBB', width, 1, 8, color, 0, 0, 0)) + chunk(b'IDAT', zlib.compress(b'\0' + pixel * width)) + chunk(b'IEND', b'')); png('/tmp/smoke/clear.png', 64, 6, b'\0\0\0\0'); png('/tmp/smoke/icon.png', 16, 6, b'\0\0\0\0'); png('/tmp/smoke/opaque.png', 64, 2, b'\0\0\0')"; \
    printf ':orphan:\n\nImages\n======\n\n.. image:: clear.png\n\n.. image:: icon.*\n\n.. image:: opaque.png\n' > /tmp/smoke/images.rst; \
    sphinx-build -b html -q -W /tmp/smoke /tmp/smoke/_build; \
    test -s /tmp/smoke/_build/_static/omnetpp-immaterial.css; \
    grep -q 'stopwords\.has' /tmp/smoke/_build/_static/sphinx_immaterial_theme.*.min.js; \
    grep -q 'class="[^"]*no-copy' /tmp/smoke/_build/nocopy.html; \
    grep -q 'href="#section" class="md-nav__link"' /tmp/smoke/_build/orphan.html; \
    grep -q '"url":"ref/p101.html"' /tmp/smoke/_build/_static/omnetpp-nav/ref__index.json; \
    if grep -q 'p101.html' /tmp/smoke/_build/api/namespacens.html; then exit 1; fi; \
    grep -q 'href="#section" class="md-nav__link"' /tmp/smoke/_build/ref/p50.html; \
    grep -q 'omnetpp-navtree.js' /tmp/smoke/_build/ref/p50.html; \
    grep -q '"title":"Namespaces","children":\[{"title":"ns","url":"api/namespacens.html","children":\[{"title":"Foo"' \
        /tmp/smoke/_build/_static/omnetpp-nav/api__index.json; \
    grep -q 'class="transparent-image" src="_images/clear.png"' /tmp/smoke/_build/images.html; \
    grep -q 'class="transparent-icon" src="_images/icon.png"' /tmp/smoke/_build/images.html; \
    grep -q 'alt="_images/opaque.png" src=' /tmp/smoke/_build/images.html; \
    find /opt/docvenv -type d -name '__pycache__' -prune -exec rm -rf {} +; \
    rm -rf /tmp/smoke

# omnetpp_neddoc: the :ned: and :msg: roles, linking type names to the NED reference that opp_docgen --format=rst
# generates into a Sphinx project, and the inlining of its diagrams (extensions/omnetpp_neddoc). A site enables it
# with extensions = [..., 'omnetpp_neddoc']. It comes after opp-tools and omnetpp_immaterial, which its smoke check
# uses: it fails the build if a site with the reference of a one-module project does not build, or does not get the
# link of a :ned: role, an inlined diagram, or, with omnetpp_immaterial, the navigation tree of the reference.
RUN --mount=type=bind,source=extensions/omnetpp_neddoc,target=/tmp/omnetpp_neddoc \
    set -eu; \
    site="$(python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')"; \
    cp -r /tmp/omnetpp_neddoc "$site/"; \
    find "$site/omnetpp_neddoc" -type d -name '__pycache__' -prune -exec rm -rf {} +; \
    chmod -R a+rX "$site/omnetpp_neddoc"; \
    mkdir -p /tmp/smoke/src /tmp/smoke/doc; \
    printf '//\n// Smoke-test module.\n//\nsimple Smoke\n{\n}\n' > /tmp/smoke/src/Smoke.ned; \
    opp_docgen --format=rst -o /tmp/smoke/doc/ned /tmp/smoke/src; \
    printf "extensions = ['omnetpp_neddoc']\n" > /tmp/smoke/doc/conf.py; \
    printf 'Smoke\n=====\n\n:ned:`Smoke`\n\n.. toctree::\n\n   ned/index\n' > /tmp/smoke/doc/index.rst; \
    sphinx-build -b html -q -W /tmp/smoke/doc /tmp/smoke/doc/_build; \
    grep -q 'href="ned/types/Smoke.html"' /tmp/smoke/doc/_build/index.html; \
    grep -q 'class="neddoc-diagram"' /tmp/smoke/doc/_build/ned/types/Smoke.html; \
    printf "html_theme = 'sphinx_immaterial'\nextensions = ['sphinx_immaterial', 'omnetpp_immaterial', 'omnetpp_neddoc']\n" > /tmp/smoke/doc/conf.py; \
    sphinx-build -b html -q -W /tmp/smoke/doc /tmp/smoke/doc/_nav; \
    grep -q '"title":"Smoke","url":"ned/types/Smoke.html"' /tmp/smoke/doc/_nav/_static/omnetpp-nav/ned__index.json; \
    find /opt/docvenv -type d -name '__pycache__' -prune -exec rm -rf {} +; \
    rm -rf /tmp/smoke

WORKDIR /work
CMD ["bash"]
